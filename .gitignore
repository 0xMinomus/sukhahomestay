# Munder Difflin floor state — app-owned runtime, never commit.
# hive/ is its own nested git repo; adding it would embed the floor as a gitlink.
/hive/
/roster-backups/
/roster.json

# Agent memory written into the working tree by a spawned agent. The floor keeps
# the real copy under hive/agents/<id>/memory.md; this one is per-session state.
/memory.md
/docs/munder-difflin/**/memory.md
